# drastic-backup default environment
#
# Load order:
#   1. .env.default
#   2. .env.<DRASTIC_ENV>
#   3. .env.<DRASTIC_ENV>.override
#   4. real process environment variables

DRASTIC_ENV=dev
TZ=UTC

# --- Container images ---
DRASTIC_SERVER_IMAGE=ghcr.io/devmato/drastic-backup-server:latest
DRASTIC_AGENT_IMAGE=ghcr.io/devmato/drastic-backup-agent:latest

# --- Agent release artifacts ---
DRASTIC_AGENT_RELEASE_BASE_URL=https://github.com
DRASTIC_AGENT_RELEASE_REPOSITORY=devmato/drastic-backup
DRASTIC_AGENT_ARTIFACT_TAG=
DRASTIC_AGENT_ARTIFACT_NAME_TEMPLATE=drastic-agent-{os}-{arch}-{tag}.{ext}
DRASTIC_ASSET_CACHE_PATH=/opt/drastic-server/asset-cache

# --- App metadata ---
DRASTIC_APP_NAME=drastic-backup
DRASTIC_API_TITLE="dRastic Backup API"
DRASTIC_API_VERSION=v1
DRASTIC_OPENAPI_VERSION=3.0.2
DRASTIC_OPENAPI_URL_PREFIX=/api
DRASTIC_OPENAPI_SWAGGER_UI_PATH=/docs
DRASTIC_OPENAPI_SWAGGER_UI_URL=https://cdn.jsdelivr.net/npm/swagger-ui-dist/
DRASTIC_CORS_ORIGINS=null
DRASTIC_SOCKETIO_CORS_ORIGINS=null

# --- Auth and API runtime ---
DRASTIC_APP_MASTER_SECRET=change-me-local-secret
DRASTIC_SECRET_KEY=
DRASTIC_JWT_SECRET_KEY=
DRASTIC_JWT_TOKEN_LOCATION=["cookies"]
DRASTIC_JWT_REFRESH_TOKEN_EXPIRES=2592000
DRASTIC_JWT_SESSION_COOKIE=false
DRASTIC_JWT_COOKIE_SECURE=false
DRASTIC_JWT_COOKIE_SAMESITE=Lax
DRASTIC_JWT_COOKIE_CSRF_PROTECT=true
DRASTIC_JWT_REFRESH_COOKIE_PATH=/api/auth
DRASTIC_JWT_ACCESS_COOKIE_PATH=/
DRASTIC_TESTING=false

# --- Ports ---
DRASTIC_BIND_BACKEND_PORT=5050
DRASTIC_HOST_BACKEND_PORT=5050
DRASTIC_BIND_DEV_FRONTEND_PORT=9050
DRASTIC_HOST_DEV_FRONTEND_PORT=9050

# --- Public routing ---
DRASTIC_PUBLIC_URL=
DRASTIC_REST_SERVER_URL=http://rest-server:8000
DRASTIC_REST_SERVER_DATA_DIRECTORY=/data
DRASTIC_DOCS_SITE_PATH=/app/docs-site
DRASTIC_RESTIC_BINARY_PATH=restic

# --- Database ---
DRASTIC_SQLALCHEMY_DATABASE_URI=mysql+pymysql://drastic:drastic@127.0.0.1:3306/drastic?charset=utf8mb4
DRASTIC_SQLALCHEMY_TRACK_MODIFICATIONS=false
DRASTIC_SQLALCHEMY_ECHO=false

# --- Gunicorn ---
DRASTIC_GUNICORN_WORKERS=1
DRASTIC_GUNICORN_THREADS=16
DRASTIC_GUNICORN_TIMEOUT=300
DRASTIC_GUNICORN_GRACEFUL_TIMEOUT=60
DRASTIC_GUNICORN_KEEPALIVE=5
DRASTIC_GUNICORN_LOG_LEVEL=info

# --- Runtime timeouts ---
DRASTIC_REST_PROXY_TIMEOUT_SECONDS=300
DRASTIC_COMMAND_TIMEOUT_SECONDS=60
DRASTIC_TASK_TIMEOUT_SECONDS=600

# --- Rest server storage ---
DRASTIC_HOST_DB_PATH=/opt/drastic-server/db
DRASTIC_REST_SERVER_STORAGE_PATH=/opt/drastic-server/restic

# --- Bootstrap admin / repository ---
DRASTIC_BOOTSTRAP_ADMIN_USERNAME=
DRASTIC_BOOTSTRAP_ADMIN_PASSWORD=
DRASTIC_BOOTSTRAP_ADMIN_UPDATE=false
DRASTIC_BOOTSTRAP_REPOSITORY_NAME=
DRASTIC_BOOTSTRAP_REPOSITORY_LOCATION=
DRASTIC_BOOTSTRAP_REPOSITORY_PASSWORD=

# --- Agent runtime ---
DRASTIC_LOGLEVEL=INFO
DRASTIC_SERVER=http://backend:5050
DRASTIC_AGENT_HOST_DATA_PATH=/opt/drastic-agent/data
DRASTIC_AGENT_HOST_ROOT_PATH=/

# --- Optional compatibility values ---
DRASTIC_SERVER_NAME=null
