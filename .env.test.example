# dRastic Backup test environment example.
# Copy to .env or run ./scripts/generate-env.sh test.

DRASTIC_ENV=test
MARIADB_PASSWORD=replace-me-test-db

DRASTIC_HOST_BACKEND_PORT=5051
DRASTIC_HOST_DB_PATH=/opt/drastic-test/db
DRASTIC_REST_SERVER_STORAGE_PATH=/opt/drastic-test/restic

DRASTIC_SQLALCHEMY_DATABASE_URI=mysql+pymysql://drastic:replace-me-test-db@db:3306/drastic?charset=utf8mb4
DRASTIC_APP_MASTER_SECRET=replace-with-a-long-random-test-secret
DRASTIC_PUBLIC_URL=https://backup-test.example.net
DRASTIC_TESTING=true
DRASTIC_JWT_COOKIE_SECURE=false

DRASTIC_BOOTSTRAP_ADMIN_USERNAME=admin
DRASTIC_BOOTSTRAP_ADMIN_PASSWORD=replace-me-bootstrap-admin
