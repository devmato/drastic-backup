# dRastic Backup agent configuration.
# Copy to .env on the agent host.

DRASTIC_AGENT_IMAGE=ghcr.io/devmato/drastic-backup-agent:v0.1.0

DRASTIC_SERVER=https://backup.example.net

# Required only for initial registration; remove them afterwards.
DRASTIC_USER=admin
DRASTIC_PASSWORD=replace-me-bootstrap-admin
