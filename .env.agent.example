# dRastic Backup agent configuration.
# Copy to .env on the agent host or edit Environment Configuration in Arcane.

DRASTIC_ENV=prod
TZ=UTC
DRASTIC_AGENT_IMAGE=ghcr.io/devmato/drastic-backup-agent:v0.1.0

DRASTIC_SERVER=https://backup.example.net
DRASTIC_AGENT_HOST_DATA_PATH=/opt/drastic-agent/data
DRASTIC_AGENT_HOST_ROOT_PATH=/

# Required only for initial registration; remove them afterwards.
DRASTIC_USER=admin
DRASTIC_PASSWORD=replace-me-bootstrap-admin

# Optional Proxmox integration.
# DRASTIC_PROXMOX_API_URL=https://127.0.0.1:8006/api2/json
# DRASTIC_PROXMOX_TOKEN_ID=root@pam!drastic-agent
# DRASTIC_PROXMOX_TOKEN_SECRET=replace-me-proxmox-token-secret
# DRASTIC_PROXMOX_VERIFY_TLS=false
# DRASTIC_PROXMOX_NODE=pve
