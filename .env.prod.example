# dRastic Backup production environment example.
# Copy to .env.prod or run ./scripts/generate-env.sh prod, then use with:
# docker compose -f docker-compose.yaml --env-file .env.prod up -d
# docker compose -f docker-compose.agent.yaml --env-file .env.prod up -d

DRASTIC_ENV=prod
TZ=UTC

DRASTIC_SERVER_IMAGE=ghcr.io/devmato/drastic-backup-server:v0.1.0
DRASTIC_AGENT_IMAGE=ghcr.io/devmato/drastic-backup-agent:v0.1.0
DRASTIC_AGENT_RELEASE_BASE_URL=https://github.com
DRASTIC_AGENT_RELEASE_REPOSITORY=devmato/drastic-backup
DRASTIC_AGENT_ARTIFACT_TAG=
DRASTIC_AGENT_ARTIFACT_NAME_TEMPLATE=drastic-agent-{os}-{arch}-{tag}.{ext}
DRASTIC_ASSET_CACHE_PATH=/opt/drastic-server/asset-cache

MARIADB_ROOT_PASSWORD=replace-me
MARIADB_DATABASE=drastic
MARIADB_USER=drastic
MARIADB_PASSWORD=replace-me

DRASTIC_BIND_BACKEND_PORT=5050
DRASTIC_HOST_BACKEND_PORT=5050
DRASTIC_HOST_DB_PATH=/opt/drastic-server/db
DRASTIC_REST_SERVER_STORAGE_PATH=/opt/drastic-server/restic

DRASTIC_SQLALCHEMY_DATABASE_URI=mysql+pymysql://drastic:replace-me@db:3306/drastic?charset=utf8mb4
DRASTIC_APP_MASTER_SECRET=replace-with-a-long-random-secret
DRASTIC_PUBLIC_URL=https://backup.example.net
DRASTIC_TESTING=false
DRASTIC_JWT_TOKEN_LOCATION=["cookies"]
DRASTIC_JWT_COOKIE_SECURE=false
DRASTIC_JWT_COOKIE_SAMESITE=Lax
DRASTIC_JWT_SESSION_COOKIE=false
DRASTIC_REST_PROXY_TIMEOUT_SECONDS=300
DRASTIC_COMMAND_TIMEOUT_SECONDS=60
DRASTIC_TASK_TIMEOUT_SECONDS=600

DRASTIC_BOOTSTRAP_ADMIN_USERNAME=admin
DRASTIC_BOOTSTRAP_ADMIN_PASSWORD=replace-me-bootstrap-admin

DRASTIC_SERVER=https://backup.example.net
DRASTIC_AGENT_HOST_DATA_PATH=/opt/drastic-agent/data
DRASTIC_AGENT_HOST_ROOT_PATH=/
DRASTIC_LOGLEVEL=INFO
DRASTIC_PROXMOX_API_URL=https://127.0.0.1:8006/api2/json
DRASTIC_PROXMOX_TOKEN_ID=root@pam!drastic-agent
DRASTIC_PROXMOX_TOKEN_SECRET=replace-me-proxmox-token-secret
DRASTIC_PROXMOX_VERIFY_TLS=false
# Optional if automatic node detection is not enough:
# DRASTIC_PROXMOX_NODE=pve

# Agent registration still uses user/password. Repository traffic uses agent secrets.
DRASTIC_USER=admin
DRASTIC_PASSWORD=replace-me-bootstrap-admin
