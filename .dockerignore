# Git is mounted read-only in the version build stage, never copied into images.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/.venv/
**/venv/
**/node_modules/
**/.yarn/
**/dist/
site/
docs-site/
**/.quasar/
**/.vite/
**/*.egg-info/
**/*.log
.env*
!.env.default
!.env.example
!.env.dev
!.env.dev.override.example
!.env.test.example
!.env.agent.example
apps/backend/storage/*
!apps/backend/storage/README.md
apps/backend/import/*
!apps/backend/import/.gitkeep
apps/backend/data/*
!apps/backend/data/.gitkeep
apps/agent/data/*
apps/agent/data-dev-native/*
