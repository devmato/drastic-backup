# dRastic Backup server configuration.
# Copy to .env or edit Environment Configuration in Arcane.

DRASTIC_ENV=prod
TZ=UTC

DRASTIC_SERVER_IMAGE=ghcr.io/devmato/drastic-backup-server:v0.1.0
DRASTIC_AGENT_IMAGE=ghcr.io/devmato/drastic-backup-agent:v0.1.0
# Keep server and agent images on the same explicit release.

MARIADB_DATABASE=drastic
MARIADB_USER=drastic
MARIADB_PASSWORD=replace-me

DRASTIC_HOST_BACKEND_ADDRESS=127.0.0.1
DRASTIC_HOST_BACKEND_PORT=5050
DRASTIC_HOST_DB_PATH=/opt/drastic-server/db
DRASTIC_REST_SERVER_STORAGE_PATH=/opt/drastic-server/restic

DRASTIC_SQLALCHEMY_DATABASE_URI=mysql+pymysql://drastic:replace-me@db:3306/drastic?charset=utf8mb4
DRASTIC_APP_MASTER_SECRET=replace-with-a-long-random-secret
DRASTIC_PUBLIC_URL=https://backup.example.net
DRASTIC_JWT_COOKIE_SECURE=true

DRASTIC_BOOTSTRAP_ADMIN_USERNAME=admin
DRASTIC_BOOTSTRAP_ADMIN_PASSWORD=replace-me-bootstrap-admin
