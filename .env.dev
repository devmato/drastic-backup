# drastic-backup development environment

DRASTIC_ENV=dev
TZ=UTC
DRASTIC_DEBUG=1
DRASTIC_TESTING=false

MARIADB_ROOT_PASSWORD=drastic-root
MARIADB_DATABASE=drastic
MARIADB_USER=drastic
MARIADB_PASSWORD=drastic

DRASTIC_SQLALCHEMY_DATABASE_URI=mysql+pymysql://drastic:drastic@db:3306/drastic?charset=utf8mb4
DRASTIC_APP_MASTER_SECRET=dev-master-secret-change-me
DRASTIC_ENCRYPTION_KEY=dev-encryption-key-change-me
DRASTIC_PUBLIC_URL=
DRASTIC_DOCS_SITE_PATH=/tmp/drastic-docs-site
DRASTIC_JWT_COOKIE_SECURE=false
DRASTIC_BOOTSTRAP_ADMIN_USERNAME=admin
DRASTIC_BOOTSTRAP_ADMIN_PASSWORD=admin
DRASTIC_BOOTSTRAP_REPOSITORY_NAME="Bootstrap Repository"
DRASTIC_BOOTSTRAP_REPOSITORY_LOCATION=/tmp/drastic-bootstrap-repository
DRASTIC_BOOTSTRAP_REPOSITORY_PASSWORD=change-me-restic-password
