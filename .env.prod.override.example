# Optional local production overrides.
# Copy to .env.prod.override when you need host-specific values on top of .env.prod.
# It is gitignored and should never contain committed secrets.

# DRASTIC_SERVER_IMAGE=ghcr.io/devmato/drastic-backup-server:v0.2.0
# DRASTIC_AGENT_IMAGE=ghcr.io/devmato/drastic-backup-agent:v0.2.0
# DRASTIC_AGENT_RELEASE_BASE_URL=https://github.com
# DRASTIC_AGENT_RELEASE_REPOSITORY=devmato/drastic-backup
# DRASTIC_AGENT_ARTIFACT_TAG=v0.2.0
# DRASTIC_PUBLIC_URL=https://backup.example.net
# DRASTIC_JWT_COOKIE_SECURE=true
# DRASTIC_HOST_BACKEND_PORT=5050
# DRASTIC_HOST_DB_PATH=/opt/drastic-server/db
# DRASTIC_REST_SERVER_STORAGE_PATH=/opt/drastic-server/restic
# DRASTIC_ASSET_CACHE_PATH=/opt/drastic-server/asset-cache
# DRASTIC_AGENT_HOST_DATA_PATH=/opt/drastic-agent/data
# DRASTIC_AGENT_HOST_ROOT_PATH=/
